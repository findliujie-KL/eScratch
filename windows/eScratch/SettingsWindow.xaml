<UserControl x:Class="eScratch.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
 <DockPanel>
  <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><DockPanel><Button x:Name="PageBackButton" DockPanel.Dock="Right" Content="Back" Click="PageBackClick" Background="Transparent"/><TextBlock x:Name="PageTitle" Text="Quick settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Border>
  <Border DockPanel.Dock="Bottom" Padding="20,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><StackPanel><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" FontSize="11" Margin="0,0,0,6"/><UniformGrid x:Name="QuickNavigation" Columns="2" Visibility="Collapsed" Margin="0,0,0,6"><Button Content="All settings" Click="AllSettingsClick" Margin="0,0,4,0" Padding="6"/><Button Content="Help &amp; shortcuts" Click="HelpClick" Margin="4,0,0,0" Padding="6"/></UniformGrid><TextBlock x:Name="AutoSaveHint" Text="Changes apply automatically" Style="{StaticResource Hint}"/></StackPanel></Border>
  <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SettingsRows" Margin="20,8">
   <StackPanel Margin="0,12"><TextBlock Text="Text alignment" Style="{StaticResource Label}"/><ComboBox x:Name="AlignmentBox" AutomationProperties.Name="Text alignment"/><TextBlock Text="Justify aligns both edges of wrapped paragraphs; the final row stays left aligned." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="Paper theme" Style="{StaticResource Label}"/><ComboBox x:Name="PaperThemeBox" AutomationProperties.Name="Paper theme"/><TextBlock Text="Use the toolbar sun / moon to switch light and dark." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="Texture intensity" Style="{StaticResource Label}"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=TextureSlider, StringFormat={}{0:0}%}" Width="40" TextAlignment="Right"/><Slider x:Name="TextureSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Texture intensity"/></DockPanel><TextBlock Text="0% removes texture. Porcelain is always smooth; notebook rules follow your font and zoom." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12">
    <TextBlock Text="Scratch font" Style="{StaticResource Label}"/>
    <ComboBox x:Name="FontPicker" TextSearch.TextPath="Name" DropDownClosed="FontSelectionCommitted" PreviewKeyDown="FontPickerKeyDown" LostKeyboardFocus="FontPickerLostFocus" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="220" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Choose scratch font">
     <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
     <ComboBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding Source}"><TextBlock Text="{Binding Name}" FontFamily="{Binding Source}" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ChineseSample}" FontFamily="{Binding Source}" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock x:Name="FontLoadingText" Text="Loading installed fonts…" Style="{StaticResource Hint}"/>
    <DockPanel Margin="0,10,0,0"><TextBox x:Name="FontSizeBox" DockPanel.Dock="Right" Width="64" AutomationProperties.Name="Scratch font size"/><TextBlock Text="Size (8–48)" VerticalAlignment="Center"/></DockPanel>
    <Button Content="Reset font" Click="ResetFontClick" HorizontalAlignment="Left" Background="Transparent" FontSize="11" Margin="0,8,0,0"/>
    <TextBlock Text="Applies to scratch text. Ctrl+scroll zooms relative to this size." Style="{StaticResource Hint}"/>
   </StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="LoginBox" Content="Start with Windows" Style="{StaticResource Switch}"/><TextBlock Text="Start quietly in the tray when you sign in. For portable builds, keep the app in the same folder." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="OpenNearPointerBox" Content="Open near the pointer" Style="{StaticResource Switch}"/><TextBlock Text="Place the window near your mouse pointer when you bring it forward." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="ReopenLastScratchBox" Content="Reopen last scratch" Style="{StaticResource Switch}"/><TextBlock Text="Continue your draft when restoring from the tray. When off, save it to history and start blank." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="CopyOnHideBox" Content="Copy draft when hiding" Style="{StaticResource Switch}"/><TextBlock Text="Copy the current draft to the clipboard when the window is hidden or closed to the tray." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="WordCountBox" Content="Show word count" Style="{StaticResource Switch}"/><TextBlock Text="Show the live word count in the bottom-right corner." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="TopmostBox" Content="Always on top" Style="{StaticResource Switch}"/><TextBlock Text="Keep the editor above other windows." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="LightBox" Content="Light theme" Style="{StaticResource Switch}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="WhitespaceBox" Content="Show whitespace" Style="{StaticResource Switch}"/><TextBlock Text="Show spaces, tabs and line endings." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><DockPanel><TextBox x:Name="HistoryLimitBox" DockPanel.Dock="Right" Width="72" TextAlignment="Right" AutomationProperties.Name="History limit"/><TextBlock Text="History limit" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Number of entries remembered (1–1000)." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="Indentation" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><ComboBox x:Name="IndentBox" Margin="0,0,10,0"><ComboBoxItem Content="Spaces"/><ComboBoxItem Content="Tabs"/></ComboBox><ComboBox x:Name="IndentSizeBox" Grid.Column="1"><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/></ComboBox></Grid></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="OCR languages" Style="{StaticResource Label}"/><TextBlock Text="Select languages, then use the arrows to set priority. The first language leads recognition; extra spaces between Chinese characters are removed." Style="{StaticResource Hint}"/><TextBlock Text="INSTALLED · PRIORITY ORDER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,12,0,4"/><StackPanel x:Name="InstalledLanguages"/><TextBlock Text="ADD LANGUAGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,16,0,8"/>
    <ComboBox x:Name="LanguagePicker" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MaxDropDownHeight="190" AutomationProperties.Name="Search OCR languages" ToolTip="Search languages by name or code"/>
    <Button x:Name="DownloadButton" Content="Download language" Click="DownloadClick" Margin="0,8,0,0"/>
    <Button x:Name="CancelDownloadButton" Content="Cancel download" IsEnabled="False" Click="CancelDownloadClick" Margin="0,4,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
    <TextBlock x:Name="DownloadStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
   </StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="JoinOcrLinesBox" Content="Join wrapped OCR lines" Style="{StaticResource Switch}"/><TextBlock Text="Join likely line wraps while keeping blank lines as paragraph breaks. Turn off for lists or line-by-line text." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="Toggle shortcut" Style="{StaticResource Label}"/><TextBox x:Name="ToggleBox" IsReadOnly="True" PreviewKeyDown="RecordShortcut"/><TextBlock Text="Click the field and press a shortcut to show or hide the editor." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="New draft shortcut" Style="{StaticResource Label}"/><TextBox x:Name="NewBox" IsReadOnly="True" PreviewKeyDown="RecordShortcut"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="Paste as Markdown shortcut" Style="{StaticResource Label}"/><TextBox x:Name="MarkdownBox" IsReadOnly="True" PreviewKeyDown="RecordShortcut"/><TextBlock Text="Active only in the editor." Style="{StaticResource Hint}"/></StackPanel>
   <Button x:Name="RestoreDefaultsButton" Content="Restore defaults" Click="RestoreDefaultsClick" HorizontalAlignment="Left" Margin="0,12"/><TextBlock x:Name="VersionText" Margin="0,20,0,12" Foreground="{DynamicResource Muted}" FontSize="11"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</UserControl>

