<UserControl x:Class="eScratch.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
 <DockPanel>
  <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold"/></Border>
  <Border DockPanel.Dock="Bottom" Padding="20,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><StackPanel><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" FontSize="11" Margin="0,0,0,6"/><Button Content="Restore defaults" Click="RestoreDefaultsClick" Margin="0,0,0,8" HorizontalAlignment="Left" Background="Transparent" FontSize="12"/><Button Content="Save settings" Click="SaveClick" Background="{DynamicResource Accent}" Foreground="{DynamicResource Surface}" FontWeight="SemiBold" HorizontalAlignment="Left"/></StackPanel></Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,8">
   <StackPanel Margin="0,12"><CheckBox x:Name="LoginBox" Content="Start with Windows" Style="{StaticResource Switch}"/><TextBlock Text="Start quietly in the tray when you sign in. For portable builds, keep the app in the same folder." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="WordCountBox" Content="Show word count" Style="{StaticResource Switch}"/><TextBlock Text="Show the live word count in the bottom-right corner." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="TopmostBox" Content="Always on top" Style="{StaticResource Switch}"/><TextBlock Text="Keep the editor above other windows." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="LightBox" Content="Light theme" Style="{StaticResource Switch}"/></StackPanel>
   <StackPanel Margin="0,12"><CheckBox x:Name="WhitespaceBox" Content="Show whitespace" Style="{StaticResource Switch}"/><TextBlock Text="Show spaces, tabs and line endings." Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel Margin="0,12"><DockPanel><TextBox x:Name="HistoryLimitBox" DockPanel.Dock="Right" Width="72" TextAlignment="Right" AutomationProperties.Name="History limit"/><TextBlock Text="History limit" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Number of entries remembered (1–1000)." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="Indentation" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><ComboBox x:Name="IndentBox" Margin="0,0,10,0"><ComboBoxItem Content="Spaces"/><ComboBoxItem Content="Tabs"/></ComboBox><ComboBox x:Name="IndentSizeBox" Grid.Column="1"><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/></ComboBox></Grid></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="OCR languages" Style="{StaticResource Label}"/><TextBlock Text="Paste a screenshot to recognize text offline. Select the languages to use." Style="{StaticResource Hint}"/><TextBlock Text="INSTALLED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,12,0,4"/><StackPanel x:Name="InstalledLanguages"/><TextBlock Text="ADD LANGUAGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,16,0,8"/>
    <ComboBox x:Name="LanguagePicker" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MaxDropDownHeight="190" AutomationProperties.Name="Search OCR languages" ToolTip="Search languages by name or code"/>
    <Button x:Name="DownloadButton" Content="Download language" Click="DownloadClick" Margin="0,8,0,0"/>
    <Button x:Name="CancelDownloadButton" Content="Cancel download" IsEnabled="False" Click="CancelDownloadClick" Margin="0,4,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
    <TextBlock x:Name="DownloadStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
   </StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="Toggle shortcut" Style="{StaticResource Label}"/><TextBox x:Name="ToggleBox" IsReadOnly="True" PreviewKeyDown="RecordShortcut"/><TextBlock Text="Click the field and press a shortcut to show or hide the editor." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="New draft shortcut" Style="{StaticResource Label}"/><TextBox x:Name="NewBox" IsReadOnly="True" PreviewKeyDown="RecordShortcut"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="Copy shortcut" Style="{StaticResource Label}"/><TextBox x:Name="CopyBox" IsReadOnly="True" PreviewKeyDown="RecordShortcut"/></StackPanel>
   <StackPanel Margin="0,12"><TextBlock Text="Paste as Markdown shortcut" Style="{StaticResource Label}"/><TextBox x:Name="MarkdownBox" IsReadOnly="True" PreviewKeyDown="RecordShortcut"/><TextBlock Text="Active only in the editor." Style="{StaticResource Hint}"/></StackPanel>
  </StackPanel></ScrollViewer>
 </DockPanel>
</UserControl>

